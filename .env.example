# Copy to .env and fill in. See README.md.

# Database: a local SQLite file in development, or a Turso/libSQL URL in production
DATABASE_URI=file:./handworks.db
# DATABASE_AUTH_TOKEN=            # only for Turso/libSQL

# Long random string used to sign admin logins (generate one: openssl rand -hex 32)
PAYLOAD_SECRET=change-me

# Public address of the site, no trailing slash. Optional on Vercel (its own address is used
# automatically); set it once you have a custom domain.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Production image storage on Vercel Blob (leave empty to store uploads in ./media)
# BLOB_READ_WRITE_TOKEN=

# Used once by 
pm run seed to create the first admin account
# SEED_ADMIN_EMAIL=
# SEED_ADMIN_PASSWORD=
